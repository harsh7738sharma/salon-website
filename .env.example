# Database Connection (MongoDB / MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/salon_db?retryWrites=true&w=majority

# SMTP Email Configuration (Gmail, Brevo, Resend, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-salon-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Serene Sanctuary Salon" <your-salon-email@gmail.com>

# Salon Admin Email (receives new booking notifications)
SALON_ADMIN_EMAIL=admin@serenesanctuary.com
